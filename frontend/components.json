{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/index.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "iconLibrary": "lucide",
  "registries": [
    {
      "name": "reactbits",
      "type": "registry:ui",
      "url": "https://pro.reactbits.dev/api/shadcn/starter",
      "headers": {
        "Authorization": "${REACTBITS_LICENSE_KEY}"
      }
    }
  ]
}
