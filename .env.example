# CivicPulse - Environment Configuration Template
# Copy this file to .env before starting the application

# Database Configuration
# Default: Local SQLite database for rapid local development
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/civicpulse_db
DATABASE_URL=sqlite:///./civicpulse.db

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=True

# Authentication & Security
# WARNING: Change JWT_SECRET_KEY in production to a secure random 32+ character key
JWT_SECRET_KEY=civicpulse-development-secret-key-change-in-production-32bytesmin
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (comma-separated list of allowed origins and frontend dev URL)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
